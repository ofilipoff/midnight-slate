  "tokenColors": [
    {
      "name": "Fallback - default source text",
      "scope": ["source", "text"],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "Comments and documentation",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "comment.line.documentation",
        "meta.documentation"
      ],
      "settings": {
        "foreground": "#749d69"
      }
    },
    {
      "name": "Comment tags",
      "scope": [
        "comment.line.documentation keyword",
        "comment.block.documentation keyword"
      ],
      "settings": {
        "foreground": "#749d69"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "keyword.declaration",
        "keyword.operator.word",
        "support.constant.language",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.cs",
        "keyword.control.csharp",
        "keyword.control.vb",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception",
        "keyword.control.trycatch",
        "keyword.control.switch"
      ],
      "settings": {
        "foreground": "#D49ADD"
      }
    },
    {
      "name": "Operators and expression punctuation",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.ternary",
        "keyword.operator.null-conditional",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.block",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "Word-like operators retain keyword color",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.alignas",
        "keyword.operator.instanceof",
        "keyword.operator.wordlike",
        "keyword.operator.expression.pattern.is.cs"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Special new operator if scoped",
      "scope": ["keyword.operator.new.cpp", "keyword.operator.new.c++"],
      "settings": {
        "foreground": "#b28ed2"
      }
    },
    {
      "name": "Namespace / imports",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.namespace",
        "meta.namespace",
        "meta.import variable.other",
        "entity.name.package",
        "meta.import entity.name.type"
      ],
      "settings": {
        "foreground": "#91b7ca"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.type.class",
        "entity.name.type.alias",
        "entity.name.type.module",
        "entity.name.type.record"
      ],
      "settings": {
        "foreground": "#60cdb8"
      }
    },
    {
      "name": "Interfaces",
      "scope": ["entity.name.type.interface", "entity.name.interface"],
      "settings": {
        "foreground": "#B8D7A3"
      }
    },
    {
      "name": "Protocols",
      "scope": "entity.name.type.protocol",
      "settings": {
        "foreground": "#B8D7A3"
      }
    },
    {
      "name": "Structs",
      "scope": ["entity.name.type.struct", "entity.name.struct"],
      "settings": {
        "foreground": "#86C691"
      }
    },
    {
      "name": "Enums",
      "scope": ["entity.name.type.enum", "entity.name.enum"],
      "settings": {
        "foreground": "#90e7b7"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember",
        "constant.other.enum",
        "entity.name.constant.enum"
      ],
      "settings": {
        "foreground": "#B8D7A3"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.type-parameter",
        "entity.name.type.parameter",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#B8D7A3"
      }
    },
    {
      "name": "Delegates and events",
      "scope": [
        "entity.name.type.delegate",
        "entity.name.event",
        "variable.other.event"
      ],
      "settings": {
        "foreground": "#C2AEDC"
      }
    },
    {
      "name": "Attributes",
      "scope": "storage.modifier.attribute",
      "settings": {
        "foreground": "#C2AEDC"
      }
    },
    {
      "name": "Methods and functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method",
        "support.method",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.operator.custom-literal"
      ],
      "settings": {
        "foreground": "#e7d49c"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.name.variable.property",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#4ddcf0"
      }
    },
    {
      "name": "Variables and fields",
      "scope": [
